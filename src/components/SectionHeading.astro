---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, lead, align = 'left' } = Astro.props;
---

<div class:list={['max-w-3xl', align === 'center' && 'mx-auto text-center']} data-reveal>
  <p class="eyebrow">
    <span class="h-px w-6 bg-linear-to-r from-brand-400 to-transparent" aria-hidden="true"></span>
    {eyebrow}
  </p>
  <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl" style="color: var(--text-primary);">
    {title}
  </h2>
  {lead && <p class="mt-4 text-base leading-relaxed" style="color: var(--text-secondary);">{lead}</p>}
</div>
