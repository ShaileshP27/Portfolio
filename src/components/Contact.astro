---
import { profile } from '../data/site';

const channels = [
  {
    label: 'Email',
    value: profile.email,
    href: `mailto:${profile.email}`,
    icon: 'M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7Zm.5 0.5 8.5 6 8.5-6',
  },
  {
    label: 'LinkedIn',
    value: profile.linkedinLabel,
    href: profile.linkedin,
    external: true,
    icon: 'M4 9h3v11H4V9Zm1.5-5a2 2 0 1 1 0 4 2 2 0 0 1 0-4ZM10 9h3v1.6a3.5 3.5 0 0 1 3.1-1.8c3.2 0 3.9 2 3.9 4.7V20h-3v-5.1c0-1.2 0-2.8-1.7-2.8s-2 1.3-2 2.7V20h-3V9Z',
  },
];
---

<section id="contact" class="scroll-mt-24 py-20 sm:py-28">
  <div class="shell">
    <div class="card relative overflow-hidden p-8 sm:p-12 lg:p-16" data-reveal>
      <!-- Ambient glow inside the CTA panel -->
      <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
        <div class="grid-bg absolute inset-0 opacity-60"></div>
        <div
          class="absolute -bottom-32 left-1/2 h-80 w-[36rem] -translate-x-1/2 rounded-full blur-[110px]"
          style="background: var(--glow-b);"
        >
        </div>
      </div>

      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] lg:gap-16">
        <div>
          <p class="eyebrow">
            <span class="h-px w-6 bg-linear-to-r from-brand-400 to-transparent" aria-hidden="true"></span>
            Contact
          </p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl" style="color: var(--text-primary);">
            Let's build something <span class="text-gradient">solid</span>
          </h2>
          <p class="mt-5 max-w-lg text-base leading-relaxed" style="color: var(--text-secondary);">
            I'm open to full-stack roles and interesting product work. The fastest way to reach me is email — I read
            everything and reply to anything concrete.
          </p>

          <div class="mt-9 flex flex-wrap gap-3">
            <a
              href={`mailto:${profile.email}`}
              class="group inline-flex items-center gap-2 rounded-xl bg-linear-to-r from-brand-500 to-accent-500 px-5 py-3 text-sm font-semibold text-ink-950 shadow-lg shadow-brand-500/25 transition-transform duration-200 hover:-translate-y-0.5"
            >
              Send an email
              <svg
                class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                aria-hidden="true"
              >
                <path d="M5 12h14m0 0-5-5m5 5-5 5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>
            <a
              href={profile.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-xl border px-5 py-3 text-sm font-semibold transition-colors duration-200 hover:border-brand-400/60 hover:text-brand-300"
              style="border-color: var(--surface-border-strong); color: var(--text-primary);"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path
                  d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05a4.2 4.2 0 0 1 3.75-2c4 0 4.75 2.6 4.75 6V21h-4v-5.6c0-1.34-.03-3.06-1.9-3.06-1.9 0-2.2 1.46-2.2 2.96V21h-4V9Z"
                ></path>
              </svg>
              Connect on LinkedIn
            </a>
          </div>

          <p class="mt-8 flex items-center gap-2 text-sm" style="color: var(--text-muted);">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11Z" stroke-linejoin="round"></path>
              <circle cx="12" cy="10" r="2.5"></circle>
            </svg>
            Based in {profile.location}
          </p>
        </div>

        <ul class="space-y-3">
          {
            channels.map((channel) => (
              <li>
                <a
                  href={channel.href}
                  target={channel.external ? '_blank' : undefined}
                  rel={channel.external ? 'noopener noreferrer' : undefined}
                  class="group flex items-center gap-4 rounded-xl border p-4 transition-colors duration-200 hover:border-brand-400/50"
                  style="border-color: var(--surface-border); background: color-mix(in oklab, var(--surface) 60%, transparent);"
                >
                  <span
                    class="grid h-11 w-11 shrink-0 place-items-center rounded-xl border transition-colors duration-200 group-hover:text-brand-300"
                    style="border-color: var(--surface-border-strong); color: var(--text-secondary);"
                    aria-hidden="true"
                  >
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                      <path d={channel.icon} stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                  <span class="min-w-0">
                    <span class="block font-mono text-[0.65rem] tracking-[0.12em] uppercase" style="color: var(--text-muted);">
                      {channel.label}
                    </span>
                    <span class="mt-0.5 block truncate text-sm font-medium" style="color: var(--text-primary);">
                      {channel.value}
                    </span>
                  </span>
                  <svg
                    class="ml-auto h-4 w-4 shrink-0 opacity-0 transition-all duration-200 group-hover:translate-x-0.5 group-hover:opacity-100"
                    style="color: var(--color-brand-400);"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path d="M5 12h14m0 0-5-5m5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
