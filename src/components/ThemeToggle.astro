---
// Dark is the default; the toggle writes an explicit override to localStorage.
---

<button
  id="theme-toggle"
  type="button"
  class="grid h-10 w-10 place-items-center rounded-lg border transition-colors duration-200 hover:border-brand-400/60 hover:text-brand-300"
  style="border-color: var(--surface-border-strong); color: var(--text-secondary);"
  aria-label="Switch colour theme"
>
  <svg id="icon-moon" class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  <svg id="icon-sun" class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" hidden>
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round"></path>
  </svg>
</button>

<script>
  const toggle = document.getElementById('theme-toggle');
  const moon = document.getElementById('icon-moon');
  const sun = document.getElementById('icon-sun');

  const current = (): 'light' | 'dark' =>
    document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';

  const syncIcons = () => {
    const isLight = current() === 'light';
    if (moon) moon.hidden = isLight;
    if (sun) sun.hidden = !isLight;
  };

  syncIcons();

  toggle?.addEventListener('click', () => {
    const next = current() === 'light' ? 'dark' : 'light';
    document.documentElement.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* storage blocked — the choice just won't persist across reloads */
    }
    syncIcons();
  });
</script>
