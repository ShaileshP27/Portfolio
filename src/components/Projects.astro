---
import SectionHeading from './SectionHeading.astro';
import { projects } from '../data/site';

const featured = projects.filter((p) => p.featured);
const others = projects.filter((p) => !p.featured);
---

<section id="projects" class="scroll-mt-24 py-20 sm:py-28">
  <div class="shell">
    <SectionHeading
      eyebrow="Projects"
      title="Selected work"
      lead="Platforms I architected or shipped end to end — the flagship SaaS first, then earlier product builds."
    />

    <!-- Featured -->
    {
      featured.map((project) => (
        <article class="card card-hover mt-14 overflow-hidden" data-reveal>
          <div
            class="h-1 w-full bg-linear-to-r from-brand-400 via-accent-400 to-accent-600"
            aria-hidden="true"
          />
          <div class="grid gap-8 p-6 sm:p-9 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-12">
            <div>
              <span class="eyebrow">Flagship</span>
              <h3 class="mt-3 text-2xl font-bold tracking-tight sm:text-3xl" style="color: var(--text-primary);">
                {project.name}
              </h3>
              <p class="mt-4 text-base leading-relaxed" style="color: var(--text-secondary);">
                {project.summary}
              </p>
              <ul class="mt-7 flex flex-wrap gap-2">
                {project.tags.map((tag) => (
                  <li class="chip">{tag}</li>
                ))}
              </ul>
            </div>

            <div
              class="rounded-xl border p-5 sm:p-6"
              style="border-color: var(--surface-border); background: color-mix(in oklab, var(--color-brand-500) 4%, transparent);"
            >
              <h4 class="font-mono text-xs tracking-[0.12em] uppercase" style="color: var(--color-brand-300);">
                What I built
              </h4>
              <ul class="mt-4 space-y-3">
                {project.highlights.map((highlight) => (
                  <li class="flex gap-3 text-sm leading-relaxed" style="color: var(--text-secondary);">
                    <span
                      class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full"
                      style="background: var(--color-accent-400);"
                      aria-hidden="true"
                    />
                    <span>{highlight}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      ))
    }

    <!-- Earlier work -->
    <div class="mt-6 grid gap-5 sm:grid-cols-2">
      {
        others.map((project, i) => (
          <article class="card card-hover flex flex-col p-6 sm:p-7" style={`--reveal-delay: ${i * 80}ms;`} data-reveal>
            <div class="flex items-start justify-between gap-4">
              <h3 class="text-lg font-semibold tracking-tight" style="color: var(--text-primary);">
                {project.name}
              </h3>
              <span
                class="grid h-9 w-9 shrink-0 place-items-center rounded-lg border"
                style="border-color: var(--surface-border); color: var(--color-brand-400);"
                aria-hidden="true"
              >
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 6h16v12H4zM4 10h16" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </div>

            <p class="mt-3 text-sm leading-relaxed" style="color: var(--text-secondary);">
              {project.summary}
            </p>

            <ul class="mt-5 space-y-2">
              {project.highlights.map((highlight) => (
                <li class="flex gap-2.5 text-[0.8125rem] leading-relaxed" style="color: var(--text-muted);">
                  <span
                    class="mt-1.5 h-1 w-1 shrink-0 rounded-full"
                    style="background: var(--color-brand-400);"
                    aria-hidden="true"
                  />
                  <span>{highlight}</span>
                </li>
              ))}
            </ul>

            <ul class="mt-auto flex flex-wrap gap-2 pt-6">
              {project.tags.map((tag) => (
                <li class="chip">{tag}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
