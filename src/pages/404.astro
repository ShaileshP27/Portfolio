---
import Base from '../layouts/Base.astro';

const home = import.meta.env.BASE_URL;
---

<Base title="404 — Page not found">
  <section class="relative flex min-h-[70vh] items-center overflow-hidden py-24">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="grid-bg absolute inset-0"></div>
      <div
        class="absolute top-0 left-1/2 h-96 w-96 -translate-x-1/2 rounded-full blur-[120px]"
        style="background: var(--glow-a);"
      >
      </div>
    </div>

    <div class="shell text-center">
      <p class="font-mono text-7xl font-extrabold tracking-tight sm:text-8xl">
        <span class="text-gradient">404</span>
      </p>
      <h1 class="mt-6 text-2xl font-bold tracking-tight sm:text-3xl" style="color: var(--text-primary);">
        This page doesn't exist
      </h1>
      <p class="mx-auto mt-4 max-w-md text-base" style="color: var(--text-secondary);">
        The link may be outdated, or the page was moved. Everything worth seeing is on the home page.
      </p>
      <a
        href={home}
        class="mt-9 inline-flex items-center gap-2 rounded-xl bg-linear-to-r from-brand-500 to-accent-500 px-5 py-3 text-sm font-semibold text-ink-950 shadow-lg shadow-brand-500/25"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M19 12H5m0 0 5-5m-5 5 5 5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        Back home
      </a>
    </div>
  </section>
</Base>
